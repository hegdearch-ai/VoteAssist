# Railway injects DATABASE_URL when the Postgres add-on is linked. Locally falls back to SQLite.
DATABASE_URL=
OTP_SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me
# Resend
EMAIL_API_KEY=
EMAIL_FROM=Madhav Hegde Campaign <otp@mail.ibrag.co.in>
EMAIL_REPLY_TO=docmadhavhegde@gmail.com
# Set to "production" on Railway (OTP is printed to logs when not production and no EMAIL_API_KEY)
APP_ENV=development
# Lookup mode: "direct" (default; Membership No is emailed/WhatsApped), "otp" (email code, then shown on page)
# or "show" (shown on page immediately, no verification)
LOOKUP_MODE=direct
# WhatsApp via Interakt: active only when BOTH are set
INTERAKT_API_KEY=
WA_TEMPLATE_MEMBER_ID=
# Add-ons (off by default)
ENABLED_ADDONS=
# ENABLED_ADDONS=chatbot,whatsapp
# ANTHROPIC_API_KEY=
